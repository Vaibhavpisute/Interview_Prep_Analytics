# Copy this file to .env and fill in only what you use. Never commit .env.

# Database. SQLite is the default; PostgreSQL is used by docker-compose.
DATABASE_URL=sqlite:///data/ipa.db
# DATABASE_URL=postgresql+psycopg://ipa:ipa@localhost:5432/ipa

# LLM provider: anthropic (default) | openai | gemini | ollama | fake
LLM_PROVIDER=anthropic
# Leave empty to use the provider's default model.
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible server, for example Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
